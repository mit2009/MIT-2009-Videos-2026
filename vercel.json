{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "vercel-site",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/videos/:filename",
      "headers": [
        {
          "key": "Content-Type",
          "value": "video/mp4"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/videos/:filename",
      "has": [
        {
          "type": "query",
          "key": "download",
          "value": "1"
        }
      ],
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\":filename\""
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/videos/MIT-2.009-Feasibility-Curved-Carousel-229-Slides-687s.mp4",
      "destination": "/videos/MIT-2.009-Feasibility-Curved-Carousel-HD.mp4",
      "permanent": false
    }
  ]
}
